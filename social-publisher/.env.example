# Source
FEED_URL=https://zq.tn/blog/feed/
ENABLED_CHANNELS=linkedin,github,reddit,x

# LinkedIn company page
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:YOUR_ORGANIZATION_ID
# Update this value when LinkedIn sunsets the selected Marketing API version.
LINKEDIN_VERSION=202608

# GitHub Discussions (GITHUB_TOKEN is supplied automatically by GitHub Actions)
GITHUB_REPOSITORY=OWNER/REPOSITORY
GITHUB_DISCUSSION_CATEGORY=announcements

# Reddit OAuth application and destination subreddit (without r/)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=script:zipquantum-blog-publisher:1.0 (by /u/ZipQuantum)

# X OAuth 1.0a user-context credentials
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

