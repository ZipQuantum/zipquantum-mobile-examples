{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProxiwebLabs/zipquantum-mobile-examples/contracts/mobile-v1.schema.json",
  "title": "ZipQuantum mobile v1 response",
  "type": "object",
  "required": ["success", "delivery", "link"],
  "properties": {
    "success": { "const": true },
    "delivery": { "enum": ["deep_link", "deferred_deep_link"] },
    "session_key": { "type": "string" },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "code": { "type": "string" },
        "host": { "type": "string" },
        "destination_url": { "type": "string", "format": "uri" },
        "fallback_url": { "type": "string" },
        "parameters": { "type": ["object", "array"] }
      },
      "additionalProperties": true
    },
    "route_ack": {
      "type": "object",
      "required": ["receipt", "expires_in", "endpoint"],
      "properties": {
        "receipt": { "type": "string", "minLength": 1, "writeOnly": true },
        "expires_in": { "type": "integer", "minimum": 1 },
        "endpoint": { "type": "string", "pattern": "^(/|https://)" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
